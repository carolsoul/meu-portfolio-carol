# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na Netlify
# (Site configuration > Environment variables). Os valores vêm do console do Firebase,
# em Configurações do projeto > Seus apps > App da Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Opcional: só preencha se ativar o Firebase Storage para enviar imagens pelo admin
VITE_FIREBASE_STORAGE_BUCKET=

# Endereço público do site, usado na imagem de compartilhamento (og:image)
VITE_SITE_URL=https://carol-sousa.netlify.app
